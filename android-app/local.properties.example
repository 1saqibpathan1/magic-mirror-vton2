# Copy this file to local.properties (which is gitignored) and fill in real
# values. local.properties is read by app/build.gradle.kts and injected into
# BuildConfig — nothing here is hardcoded into source, and this file itself
# must never be committed since it ends up holding your device key.

sdk.dir=/path/to/your/Android/sdk

# The pilot backend's base URL. For a physical device/kiosk box on the same
# network as your dev machine, use your machine's LAN IP, not localhost.
magicMirror.baseUrl=http://192.168.1.50:8000

# Must match DEVICE_API_KEY in backend/.env
magicMirror.deviceApiKey=change-me-device-key
