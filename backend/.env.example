# Shared secret the Android app sends as the X-Device-Key header.
# Pilot-grade (one store, one device) — generate a long random string per deployment.
DEVICE_API_KEY=change-me-device-key

# From your FASHN account (https://fashn.ai). Never put this in the Android app.
FASHN_API_KEY=your_fashn_api_key_here

# When true, try-on jobs are simulated instead of calling FASHN — lets you build
# and test the Android app end to end before you have a FASHN key, or to demo
# without spending credits. Turn off for the real pilot.
MOCK_FASHN_PROVIDER=true

DATABASE_URL=sqlite:///./magic_mirror.db
MEDIA_ROOT=./media

# Public base URL this backend is reachable at (used to build image/share links).
# For local dev with an Android device/emulator on the same network, use your
# machine's LAN IP instead of localhost, e.g. http://192.168.1.50:8000
BASE_URL=http://localhost:8000
